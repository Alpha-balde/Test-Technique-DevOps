# --- Secrets & local environment (never commit) ---
.env
.env.*
!.env.example
*.pem
*.pfx
*.key

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
tfplan.txt
*.tfplan.txt
# Only root configurations (environments/*) commit their lock file
modules/**/.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Variable files that could hold secrets (committed *.tfvars must stay secret-free)
*.auto.tfvars
*.secret.tfvars

# --- .NET ---
bin/
obj/
TestResults/
*.user
*.suo
.vs/
*.trx
coverage*/

# --- Node / Angular ---
node_modules/
dist/
.angular/
npm-debug.log*

# --- IDE / OS ---
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db
.DS_Store
